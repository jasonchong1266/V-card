<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BIGO Traffic Tracker" android:textSize="26sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvChannel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Target: 🥭芒果曲奇 · 1120716693" android:textSize="16sp"/>
<TextView android:id="@+id/tvStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Status: Stopped" android:textSize="18sp" android:textStyle="bold"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal"><Button android:id="@+id/btnStart" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Start Tracking"/><Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="Stop"/></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Live statistics" android:textSize="20sp" android:textStyle="bold"/>
<TextView android:id="@+id/tvCurrent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Current traffic: —" android:textSize="18sp"/><TextView android:id="@+id/tvPeak" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Peak traffic: —" android:textSize="18sp"/><TextView android:id="@+id/tvAverage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Average traffic: —" android:textSize="18sp"/><TextView android:id="@+id/tvSamples" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Samples: 0" android:textSize="18sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Capture interval" android:textStyle="bold"/><Spinner android:id="@+id/spInterval" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Viewer detection area (% of screen). Preset for the upper-right BIGO counter."/>
<EditText android:id="@+id/etRoiLeft" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ROI left %" android:inputType="numberDecimal" android:text="78"/><EditText android:id="@+id/etRoiTop" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ROI top %" android:inputType="numberDecimal" android:text="4"/><EditText android:id="@+id/etRoiRight" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ROI right %" android:inputType="numberDecimal" android:text="94"/><EditText android:id="@+id/etRoiBottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="ROI bottom %" android:inputType="numberDecimal" android:text="11"/>
<Button android:id="@+id/btnExport" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Export CSV"/><TextView android:id="@+id/tvLastRead" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Last OCR: —"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Screenshots are processed on-device and not stored. Only timestamp and detected traffic values are saved locally."/>
</LinearLayout></ScrollView>